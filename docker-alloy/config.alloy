prometheus.exporter.blackbox "prober" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"

  target {
    name    = "example"
    address = "https://example.com"
    module = "http_2xx"
  }

  target {
    name    = "grafana"
    address = "https://grafana.com"
    module = "http_2xx"
  }
}

discovery.relabel "relabel_prober" {
  targets = prometheus.exporter.blackbox.prober.targets

  rule {
    source_labels = ["__param_target"]
    target_label = "instance"
  }
}

prometheus.scrape "blackbox" {
  targets = discovery.relabel.relabel_prober.output
  forward_to = [prometheus.remote_write.metrics_service.receiver]
}

